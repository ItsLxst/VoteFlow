generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  category       String
  status         String    @default("PENDING")
  votes          Int       @default(0)
  tags           String[]
  authorName     String
  authorInitials String
  createdAt      DateTime  @default(now())
  comments       Comment[]
}

model Comment {
  id             Int      @id @default(autoincrement())
  content        String
  authorName     String
  authorInitials String
  createdAt      DateTime @default(now())
  postId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}